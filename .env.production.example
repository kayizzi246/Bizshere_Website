# Settings for docker-compose.prod.yml. Copy to .env.production and fill in.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# .env.production is git-ignored and is never copied into the image (.dockerignore excludes it).
# Generate each secret below with:  openssl rand -base64 32

# ── Database (a container in the stack; no managed host, nothing to open a firewall for) ──
POSTGRES_USER=bizsphere
POSTGRES_PASSWORD=
POSTGRES_DB=bizsphere
# DATABASE_URL is NOT set here — docker-compose.prod.yml builds it from the three values above
# and points it at the `db` service. Setting it here would be ignored.

# ── The site ──
# The public https address. Not http://localhost:3000, or sign-in redirects to a dead host.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
# The secret staff sign-in path, used as /staff/<ADMIN_LOGIN_KEY>.
ADMIN_LOGIN_KEY=

# The first admin account, created by `npm run db:seed:production`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Only needed if you call GET /api/cron/daily.
CRON_SECRET=

# The port the host publishes. Behind a reverse proxy, 127.0.0.1:3000 keeps it off the internet.
APP_PORT=3000

# ── Optional integrations: set the ones you use ──
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=
PESAPAL_IPN_ID=
RESEND_API_KEY=
EMAIL_FROM=
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
EGOSMS_SENDER_ID=
EGOSMS_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
