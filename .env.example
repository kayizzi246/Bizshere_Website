# Copy this file to .env and fill in the values.

# PostgreSQL connection. Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://bizsphere:bizsphere@localhost:5432/bizsphere?schema=public"

# NextAuth. Generate a secret with:  openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@bizsphere.local"
SEED_ADMIN_PASSWORD="change-me-now"

# Protects /api/cron/daily (daily jobs). Vercel Cron sends it automatically when set.
# Generate one the same way as NEXTAUTH_SECRET.
CRON_SECRET=""

# Private file storage for downloads and verification documents (served only via /api/files/[id])
UPLOAD_DIR="uploads"

# Payments through Pesapal (MTN MoMo, Airtel Money, cards), shown inside the membership pop-up.
# Keys: Pesapal merchant dashboard → API keys (sandbox keys from developer.pesapal.com for testing).
# PESAPAL_ENV="sandbox" uses the demo server, where no real money moves; leave empty for live.
# PESAPAL_IPN_ID is optional: without it the IPN address <NEXTAUTH_URL>/api/payments/webhook is
# registered automatically. NEXTAUTH_URL must be the public https address for Pesapal to reach it.
# See src/lib/payments.ts. Test prices: npm run plans:test-prices
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_ENV="sandbox"
PESAPAL_IPN_ID=""

# Email for membership receipts and renewal reminders (members who signed up with an email),
# sent through Resend (resend.com). EMAIL_FROM must be on a domain verified there, e.g.
# "BizSphere-Ug <hello@bizsphere.ug>". Members with a phone number get the same by SMS (EgoSMS).
RESEND_API_KEY=""
EMAIL_FROM=""

# Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) with redirect URI  <NEXTAUTH_URL>/api/auth/callback/google
# Leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Demo only: "true" makes membership payments succeed without charging anyone.
# NEVER set this on the live server.
PAYMENT_SIMULATE=""

# Phone sign-in codes are sent by SMS through EgoSMS (src/lib/sms.ts).
# Username and password: Comms account → Settings → API Settings.
# Sender ID is optional (default "EgoSMS") and must be approved on the account first.
# Check the connection with: npm run sms:test -- 0772123456
EGOSMS_USERNAME=""
EGOSMS_PASSWORD=""
EGOSMS_SENDER_ID=""
# Leave empty for the live service; set to the sandbox address only for testing.
EGOSMS_URL=""
# Local testing only: "true" prints each SMS (with the sign-in code) in the `npm run dev`
# terminal instead of sending it, so phone sign-up works on localhost without EgoSMS.
# Has no effect on Vercel or in production builds.
SMS_CONSOLE=""

# Phone sign-in codes: test login without SMS.
# Testing only: a number that signs in with a fixed code and no SMS, e.g. 123456789 / 0000.
# NEVER set these on the live server: anyone who knows them could sign in.
OTP_TEST_PHONE=""
OTP_TEST_CODE=""

# Private staff sign-in link: /staff/<ADMIN_LOGIN_KEY>. At least 16 characters, random, never shared.
# Generate one with: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_LOGIN_KEY=""

# Admin uploads (images and PDFs). In Vercel: Storage → Create → Blob, connected to this
# project, adds this automatically. Leave empty locally: files then go to public/uploads/.
BLOB_READ_WRITE_TOKEN=""
