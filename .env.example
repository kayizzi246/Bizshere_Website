# Copy this file to .env and fill in the values.

# PostgreSQL connection. Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://bizsphere:bizsphere@localhost:5432/bizsphere?schema=public"

# NextAuth. Generate a secret with:  openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@bizsphere.local"
SEED_ADMIN_PASSWORD="change-me-now"

# Protects /api/cron/daily (daily jobs). Vercel Cron sends it automatically when set.
# Generate one the same way as NEXTAUTH_SECRET.
CRON_SECRET=""

# Private file storage for downloads and verification documents (served only via /api/files/[id])
UPLOAD_DIR="uploads"

# Payment gateway (MTN MoMo, Airtel Money, cards). Not wired up yet: see src/lib/payments.ts
PAYMENT_PROVIDER=""
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
