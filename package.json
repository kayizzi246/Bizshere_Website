{
  "name": "bizsphere-ug",
  "version": "0.1.0",
  "private": true,
  "description": "BizSphere-Ug business information platform: website, business portal and admin",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:constraints": "prisma db execute --file prisma/sql/constraints.sql --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && npm run db:constraints && npm run db:seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "jobs": "tsx scripts/jobs.ts",
    "docs:db": "tsx scripts/data-dictionary.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "next": "14.2.35",
    "next-auth": "4.24.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.47",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}
